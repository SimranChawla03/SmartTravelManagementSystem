# Smart Travel Management System - Environment Configuration Template
# Duplicate this file to .env and provide your actual secrets.

# Flask Configuration
SECRET_KEY=replace-with-a-secure-random-secret-key

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=smart_travel_db

# Port (Optional, defaults to 5000 locally, configured dynamically by Render in production)
PORT=5000
